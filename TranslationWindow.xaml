<Window x:Class="RealtimeTranslator.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时译文"
        Width="560"
        Height="180"
        MinWidth="280"
        MinHeight="110"
        MaxHeight="420"
        FontFamily="{StaticResource AppFont}"
        Background="#FDFEFF"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Closing="Window_Closing">
    <Grid Background="#FDFEFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F2F6FC" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="最新译文" FontSize="13" FontWeight="SemiBold" Foreground="#2A5CAA"/>
                <TextBlock x:Name="WindowStateText" Grid.Column="1" Text="就绪" FontSize="11" Foreground="#8A95A1" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="主窗口" FontSize="11" Padding="8,3" MinHeight="22" Background="Transparent" BorderBrush="#C6D6EE" BorderThickness="1" Cursor="Hand" Click="ShowMainButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#E4EAF2" BorderThickness="0,1,0,1" Background="#FFFFFF" Padding="14,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SourceText" Text="等待识别文字..." TextWrapping="Wrap" FontSize="12" Foreground="#778391" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TranslationText" Text="" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Foreground="#15283E" LineHeight="27"/>
                    <TextBlock x:Name="ErrorText" Text="" TextWrapping="Wrap" FontSize="12" Foreground="#C43B3B" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="#F8FAFD" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ModeText" Text="屏幕文字" FontSize="11" Foreground="#8A95A1" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="可拖动、可调整大小" FontSize="11" Foreground="#A2ACB7" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
